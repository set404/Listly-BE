datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserKind {
  REGISTERED
  GUEST
}

enum AvatarColor {
  indigo
  rose
  amber
  emerald
  sky
  orange
  pink
  violet
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupType {
  STANDARD
  WISHLIST
  EXPENSE
}

model User {
  id           String      @id @default(cuid())
  kind         UserKind
  email        String?     @unique
  passwordHash String?
  googleId     String?     @unique
  name         String
  avatarColor  AvatarColor @default(indigo)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  guestRecovery       GuestRecovery?
  memberships         GroupMember[]
  refreshTokens       RefreshToken[]
  createdItems        ListItem[]
  pushTokens          PushToken[]
  paidExpenses        Expense[]      @relation("ExpensePaidBy")
  createdExpenses     Expense[]      @relation("ExpenseCreatedBy")
  expenseSplits       ExpenseSplit[]
  settlementsSent     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  createdSettlements  Settlement[]   @relation("SettlementCreatedBy")

  @@index([kind])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GuestRecovery {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintHash String
  lastIp          String
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([fingerprintHash, lastIp])
  @@index([lastSeenAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Group {
  id              String    @id @default(cuid())
  name            String
  emoji           String    @default("📋")
  type            GroupType @default(STANDARD)
  inviteCode      String    @unique
  shareToken      String?   @unique
  defaultCurrency String    @default("USD")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members     GroupMember[]
  lists       List[]
  bonusCards  BonusCard[]
  expenses    Expense[]
  settlements Settlement[]

  @@index([type])
}

model BonusCard {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  imageUrl  String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model List {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items ListItem[]

  @@index([groupId])
}

model ListItem {
  id          String    @id @default(cuid())
  listId      String
  text        String
  imageUrl    String?
  price       Float?
  currency    String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  createdById String?

  list      List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([listId])
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String
  description String
  amount      Float
  currency    String
  paidById    String
  createdAt   DateTime @default(now())
  createdById String?

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  splits    ExpenseSplit[]

  @@index([groupId])
}

// One row per person the expense is split between — amount is that
// person's equal share (shares sum exactly to Expense.amount, with any
// rounding remainder absorbed into the payer's own share).
model ExpenseSplit {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  amount    Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

// A recorded real-world payment between two members (e.g. cash or a bank
// transfer outside the app) that settles part of their balance — not tied to
// any specific Expense, just a standalone credit from fromUser to toUser.
model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  fromUserId  String
  toUserId    String
  amount      Float
  currency    String
  createdAt   DateTime @default(now())
  createdById String?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser  User  @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User  @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([groupId])
}
